// JMIT PM — data model
// PostgreSQL provider. Run `npm run db:migrate` to apply.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
  URL
}

enum RecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ProjectVisibility {
  WORKSPACE
  PRIVATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  color        String   @default("#4f8cff")
  createdAt    DateTime @default(now())

  memberships    Membership[]
  assignments    Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreator")
  comments       Comment[]
  timeLogs       TimeLog[]
  activities     Activity[]
  observers      TaskObserver[]
  checklistItems ChecklistItem[]
  reminders      Reminder[]
  filters        FilterPreset[]
  invitesSent     WorkspaceInvite[] @relation("InvitesSent")
  invitesAccepted WorkspaceInvite[] @relation("InvitesAccepted")
  notifications   Notification[]    @relation("Notifications")
  actedNotifications Notification[] @relation("NotificationsActor")
  projectMemberships ProjectMember[]
  templates       ProjectTemplate[] @relation("TemplateCreator")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  projects    Project[]
  activities  Activity[]
  tags        Tag[]
  filters     FilterPreset[]
  invites     WorkspaceInvite[]
  notifications Notification[]
  templates   ProjectTemplate[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  key          String
  description  String?
  color        String   @default("#4f8cff")
  archived     Boolean  @default(false)
  visibility   ProjectVisibility @default(WORKSPACE)
  createdAt    DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  statuses     Status[]
  tasks        Task[]
  customFields CustomField[]
  members      ProjectMember[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

/// Opt-in list that makes a PRIVATE project visible to a workspace member.
model ProjectMember {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// A reusable blueprint: columns, custom fields and starter tasks, stored as JSON.
model ProjectTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  blueprint   Json
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Status {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory @default(TODO)
  position  Int            @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id             String    @id @default(cuid())
  projectId      String
  number         Int
  title          String
  description    String?
  statusId       String
  priority       Priority  @default(MEDIUM)
  assigneeId     String?
  creatorId      String
  parentId       String?
  position       Float     @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  plannedMinutes Int?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status   Status   @relation(fields: [statusId], references: [id])
  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User     @relation("TaskCreator", fields: [creatorId], references: [id])
  parent   Task?    @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]   @relation("SubTasks")

  comments   Comment[]
  timeLogs   TimeLog[]
  tags       TaskTag[]
  checklists Checklist[]
  observers  TaskObserver[]
  reminders  Reminder[]
  attachments Attachment[]
  customValues CustomFieldValue[]

  // Rows where this task is the dependent one (this task waits on dependsOnId).
  blockedBy TaskDependency[] @relation("DependentTask")
  // Rows where this task is what others wait on.
  blocks    TaskDependency[] @relation("BlockingTask")

  recurrence Recurrence?
  notifications Notification[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([projectId, dueDate])
  @@index([assigneeId])
  @@index([parentId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TimeLog {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String
  taskId      String?
  type        String
  message     String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([taskId, createdAt])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#8b93a1")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model Checklist {
  id       String @id @default(cuid())
  taskId   String
  title    String
  position Int    @default(0)

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([taskId])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  text        String
  done        Boolean   @default(false)
  assigneeId  String?
  dueDate     DateTime?
  position    Int       @default(0)

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId])
}

model TaskObserver {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Reminder {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  remindAt  DateTime
  dismissed Boolean   @default(false)
  notifiedAt DateTime?
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Recurrence {
  id       String         @id @default(cuid())
  taskId   String         @unique
  rule     RecurrenceRule
  interval Int            @default(1)
  nextAt   DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model CustomField {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      CustomFieldType @default(TEXT)
  options   String[]        @default([])
  position  Int             @default(0)

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  CustomFieldValue[]

  @@index([projectId])
}

model CustomFieldValue {
  id      String @id @default(cuid())
  fieldId String
  taskId  String
  value   String?

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  task  Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([fieldId, taskId])
  @@index([taskId])
}

model FilterPreset {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  projectId   String?
  name        String
  state       Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
}

/// A shareable link that lets someone join a workspace without an existing account.
model WorkspaceInvite {
  id           String       @id @default(cuid())
  workspaceId  String
  email        String
  role         Role         @default(MEMBER)
  token        String       @unique
  status       InviteStatus @default(PENDING)
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email])
}

/// Per-user inbox entry. One row per person per event, so read state stays personal.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  actorId     String?
  taskId      String?
  type        String
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation("Notifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationsActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, workspaceId, createdAt])
  @@index([workspaceId, createdAt])
}
